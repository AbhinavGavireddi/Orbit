# Copy to .env. Keep private; never commit real credentials.
OPENAI_API_KEY=  # task (embeddings), voice, automation, research
TYPESAFE_API_KEY=
# Generate both with: python3 scripts/setup.py
ORBIT_DEVICE_TOKEN=
ORBIT_SERVICE_TOKEN=
ORBIT_REALTIME_MODEL=gpt-realtime-2.1-mini
ORBIT_TRANSCRIBE_MODEL=gpt-4o-transcribe
ORBIT_AGENT_MODEL=gpt-5.6-sol
ORBIT_JEV_MODEL=jev-1.13.0
ORBIT_ARTIFACT_DIR=./var/artifacts
REDIS_URL=redis://127.0.0.1:6379/0
ORBIT_TASK_URL=http://127.0.0.1:8100
ORBIT_DECISION_URL=http://127.0.0.1:8104
ORBIT_MAX_TASK_STEPS=30
# Comma-separated page allowlist for task Playwright. Empty refuses every page.
ORBIT_BROWSER_HOSTS=

# Plugins: MCP servers + skill roots. See docs/PLUGINS.md and config/orbit.plugins.example.yaml.
# ORBIT_PLUGINS_CONFIG=config/orbit.plugins.yaml
# Default skill roots include the shipped ./skills tree and personal home skill dirs.
ORBIT_SKILL_ROOTS=./skills,home

# Task uses this for Redis-side memory embeddings; recall falls back to keyword-only when the API key is unset.
ORBIT_EMBEDDING_MODEL=text-embedding-3-small
