# Production deployment template. Copy to .env.prod on the server.
# Never commit real credentials or tokens.

ORBIT_REGISTRY=ghcr.io/your-org
ORBIT_IMAGE_TAG=0.1.0

ORBIT_TASK_HOST=api.orbit.example.com
ORBIT_VOICE_HOST=voice.orbit.example.com
ACME_EMAIL=ops@example.com

# Generate distinct 40+ character tokens per isolated deployment.
ORBIT_DEVICE_TOKEN=
ORBIT_SERVICE_TOKEN=

OPENAI_API_KEY=
TYPESAFE_API_KEY=

ORBIT_REALTIME_MODEL=gpt-realtime-2.1-mini
ORBIT_TRANSCRIBE_MODEL=gpt-4o-transcribe
ORBIT_AGENT_MODEL=gpt-5.6-sol
ORBIT_JEV_MODEL=jev-1.13.0

# Keep shadow until promotion gates and live acceptance pass for the release.
ORBIT_JEV_MODE=shadow
ORBIT_JEV_CAPABILITIES=
ORBIT_VAD_EAGERNESS=medium

REDIS_MAXMEMORY=1gb
ORBIT_MAX_TASK_STEPS=30
ORBIT_BROWSER_HOSTS=

# Plugins — see docs/PLUGINS.md
ORBIT_SKILL_ROOTS=./skills,home
# ORBIT_PLUGINS_CONFIG=config/orbit.plugins.yaml
